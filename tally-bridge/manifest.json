{
  "manifest_version": 3,
  "name": "Mukesh Compliances - Tally Bridge",
  "version": "1.0",
  "description": "Lets mukeshcompliances.github.io talk to Tally on this computer (localhost:9000). Nothing else.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://localhost:9000/*", "http://127.0.0.1:9000/*"],
  "externally_connectable": { "matches": ["https://mukeshcompliances.github.io/*"] }
}
